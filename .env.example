# Auth modes:
# none  = no built-in auth
# proxy = require reverse proxy headers such as X-Forwarded-User
# oidc  = use Authentik / OpenID Connect
AUTH_MODE=none

# Required when AUTH_MODE=oidc
SECRET_KEY=
PUBLIC_BASE_URL=https://scdl.example.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
TRUST_PROXY_HEADERS=true

OIDC_CLIENT_ID=scdl-web
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=https://auth.example.com/application/o/scdl-web/.well-known/openid-configuration
OIDC_SCOPES=openid profile email
OIDC_ALLOWED_GROUPS=
OIDC_GROUPS_CLAIM=groups
OIDC_USERNAME_CLAIM=preferred_username

# Optional. Logs the user out of Authentik too.
OIDC_END_SESSION_URL=https://auth.example.com/application/o/scdl-web/end-session/

LOG_DIR=/logs
TZ=Australia/Brisbane